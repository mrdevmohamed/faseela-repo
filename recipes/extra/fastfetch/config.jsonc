{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.30.1/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/logos/faseela.txt",
    "color": {
      "1": "green",
      "2": "white",
      "3": "yellow"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green",
      "title": "yellow",
      "output": "white",
      "separator": "yellow"
    },
    "key": {
      "type": "string",
      "width": 10
    },
    "brightColor": true,
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "initsystem", "key": "Init" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Display" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "Window" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "terminalfont", "key": "Font" },
    { "type": "cpu", "key": "CPU", "showPeCoreCount": true },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk" },
    "break",
    "colors"
  ]
}
