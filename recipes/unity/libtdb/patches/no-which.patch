# libtdb: do not shell out to `which` to locate waf.
# The build root has no `which` binary; waf ships in-tree at
# buildtools/bin/waf, so use that path directly.
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,6 @@
 # simple makefile wrapper to run waf
 
-WAF_BIN=`PATH=buildtools/bin:../../buildtools/bin:$$PATH which waf`
+WAF_BIN=buildtools/bin/waf
 WAF_BINARY=$(PYTHON) $(WAF_BIN)
 WAF=PYTHONHASHSEED=1 WAF_MAKE=1 $(WAF_BINARY)
 
