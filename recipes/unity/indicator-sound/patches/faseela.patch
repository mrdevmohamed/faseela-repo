--- a/vapi/accounts-service.vapi
+++ b/vapi/accounts-service.vapi
@@ -0,0 +1,20 @@
+/* Minimal hand-written VAPI for libaccountsservice (Act namespace).
+ *
+ * indicator-sound only uses Act.UserManager.get_default(), get_user(),
+ * Act.User.is_loaded and Act.User.get_object_path(). Upstream generates
+ * this VAPI from AccountsService-1.0.gir via vapigen, but the Faseela
+ * accountsservice recipe builds with introspection disabled, so no .gir
+ * exists in the build root. This binding covers exactly the API the
+ * service uses; the C functions come from libaccountsservice (act/act.h).
+ * is_loaded carries an explicit cname: the C API is act_user_is_loaded(),
+ * a plain function — the default getter name valac would emit,
+ * act_user_get_is_loaded(), does not exist in libaccountsservice.
+ */
+[CCode (cheader_filename = "act/act.h")]
+namespace Act {
+	public class UserManager : GLib.Object {
+		public static UserManager get_default ();
+		public User? get_user (string username);
+	}
+	public class User : GLib.Object {
+		[CCode (cname = "act_user_is_loaded")]
+		public bool is_loaded { get; }
+		public string get_object_path ();
+	}
+}
