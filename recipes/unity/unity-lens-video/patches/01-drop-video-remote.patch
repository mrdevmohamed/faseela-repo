# Drop unity-scope-video-remote entirely (dead Canonical web service).
#
# The remote scope searched Canonical's online video service
# (ubuntu-video-search.vala) via libsoup-gnome-2.4 + json-glib-1.0; the
# service is gone, so the binary would be dead weight that drags in
# libsoup2. The LOCAL daemon (unity-video-lens-daemon: Zeitgeist +
# local files + thumbnails) is untouched and needs neither libsoup nor
# json-glib — json-glib was used ONLY by the remote scope. This patch:
# - configure.ac: drop libsoup-gnome-2.4 and json-glib-1.0 from the
#   SCOPE_DAEMON PKG check (zeitgeist-1.0, dee, gee, unity stay), and
#   drop data/remote.scope.in from AC_CONFIG_FILES (the file is deleted
#   by the recipe's prepare step, so autoreconf would fail without this);
# - src/Makefile.am: remove unity-scope-video-remote from
#   pkglibexec_PROGRAMS and delete its CPPFLAGS/VALAFLAGS/LDADD/
#   VALASOURCES/SOURCES blocks, its .vala.stamp rule and all references
#   in BUILT_SOURCES/EXTRA_DIST/CLEANFILES;
# - data/Makefile.am: stop installing the remote D-Bus service and the
#   remote.scope file (local.scope stays).
# The recipe's prepare step `rm -f`s the remote .vala files, the remote
# .service.in and remote.scope.in.in. The locate code is KEPT (see the
# recipe comment): a missing `locate` binary degrades gracefully.
--- a/configure.ac
+++ b/configure.ac
@@ -70,5 +70,3 @@
                   dee-1.0 >= 1.0.7
                   gee-0.8
-                  libsoup-gnome-2.4
-                  json-glib-1.0
                   zeitgeist-1.0 >= 0.3.8
@@ -174,8 +174,7 @@
 AC_CONFIG_FILES([
   Makefile
   data/Makefile
   data/local.scope.in
-  data/remote.scope.in
   src/Makefile
   po/Makefile.in
   src/config.vala
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -12,4 +12,3 @@
 pkglibexec_PROGRAMS = \
 	unity-video-lens-daemon \
-	unity-scope-video-remote \
 	$(NULL)
@@ -25,13 +25,3 @@
   $(NULL)
 
-unity_scope_video_remote_CPPFLAGS = \
-  -DDATADIR=\"$(DATADIR)\" \
-  -DPKGDATADIR=\"$(PKGDATADIR)\" \
-  -DGETTEXT_PACKAGE=\"$(GETTEXT_PACKAGE)\" \
-  -DG_LOG_DOMAIN=\"unity-scope-video-remote\" \
-  $(SCOPE_DAEMON_CFLAGS) \
-  $(MAINTAINER_CFLAGS) \
-  -I$(srcdir) \
-  $(NULL)
-
 unity_video_lens_daemon_VALAFLAGS = \
@@ -51,23 +51,3 @@
   $(NULL)
 
-unity_scope_video_remote_VALAFLAGS = \
-  -C \
-  --pkg dee-1.0 \
-  --pkg unity \
-  --pkg unity-extras \
-  --pkg gio-2.0 \
-  --pkg gio-unix-2.0 \
-  --pkg glib-2.0 \
-  --pkg gee-0.8 \
-  --pkg zeitgeist-1.0 \
-  --pkg libsoup-gnome-2.4 \
-  --pkg libsoup-2.4 \
-  --pkg json-glib-1.0 \
-  --vapidir $(srcdir) \
-  --vapidir $(top_srcdir)/vapi \
-  --target-glib=2.26 \
-  $(MAINTAINER_VALAFLAGS) \
-  $(NULL)
-
-
 unity_video_lens_daemon_LDADD = \
@@ -75,7 +75,3 @@
   $(NULL)
 
-unity_scope_video_remote_LDADD = \
-  $(SCOPE_DAEMON_LIBS) \
-  $(NULL)
-
 unity_video_lens_daemon_VALASOURCES = \
@@ -91,13 +91,3 @@
   $(NULL)
 
-unity_scope_video_remote_VALASOURCES = \
-  config.vala \
-  remote-scope-globals.vala \
-  remote-video-main.vala \
-  remote-scope.vala \
-  ubuntu-video-search.vala \
-  utils.vala \
-  video-file.vala \
-  $(NULL)
-
 unity_video_lens_daemon_SOURCES = \
@@ -105,7 +105,3 @@
   $(NULL)
 
-unity_scope_video_remote_SOURCES = \
-  $(unity_scope_video_remote_VALASOURCES:.vala=.c) \
-  $(NULL)
-
 BUILT_SOURCES += \
@@ -111,4 +111,3 @@
 BUILT_SOURCES += \
   unity_video_lens_daemon.vala.stamp \
-  unity_scope_video_remote.vala.stamp \
   $(NULL)
@@ -116,6 +116,4 @@
 EXTRA_DIST += \
   unity_video_lens_daemon.vala.stamp \
-  unity_scope_video_remote.vala.stamp \
   $(unity_video_lens_daemon_VALASOURCES) \
-  $(unity_scope_video_remote_VALASOURCES) \
   $(NULL)
@@ -125,7 +125,3 @@
 	@touch $@
 
-unity_scope_video_remote.vala.stamp: $(unity_scope_video_remote_VALASOURCES)
-	$(AM_V_GEN) $(VALAC) $(unity_scope_video_remote_VALAFLAGS) $^
-	@touch $@
-
 CLEANFILES += \
@@ -131,5 +131,4 @@
 CLEANFILES += \
   *.stamp \
   $(unity_video_lens_daemon_VALASOURCES:.vala=.c) \
-  $(unity_scope_video_remote_VALASOURCES:.vala=.c) \
   $(NULL)
--- a/data/Makefile.am
+++ b/data/Makefile.am
@@ -1,5 +1,4 @@
 dbus_servicesdir = $(DBUSSERVICEDIR)
 service_in_files =  \
-  unity-scope-video-remote.service.in \
   unity-scope-video-local.service.in \
   $(NULL)
@@ -12,3 +12,3 @@
-scope_in_files = local.scope.in remote.scope.in
+scope_in_files = local.scope.in
 scopedir = $(SCOPESDIR)/video
 scope_DATA = $(scope_in_files:.scope.in=.scope)
@@ -23,6 +23,4 @@
 CLEANFILES = \
-  unity-scope-video-remote.service \
   unity-lens-video.service \
   local.scope \
-  remote.scope \
   $(NULL)
